---
import QRCode from 'qrcode';
import downloads from '../data/downloads.json';
import { validateDownloads } from '../../scripts/config.mjs';
validateDownloads(downloads);
const { entries = downloads.mirrors, heading = '选择网盘下载', headingId = 'mirror-heading' } = Astro.props;
const mirrors = await Promise.all(entries.filter(x => x.enabled).map(async m => ({ ...m, qr: await QRCode.toDataURL(m.url, { width: 320, margin: 3, errorCorrectionLevel: 'M', color: { dark: '#232d2b', light: '#ffffff' } }) })));
---
{mirrors.length > 0 && <section class="mirror-panel" aria-labelledby={headingId}><h2 id={headingId}>{heading}</h2><p class="fine">扫码或打开你使用的网盘，按文件名选择对应版本。登录、转存和客户端要求以网盘提示为准。</p><div class="netdisk-grid">{mirrors.map(m => <section class="netdisk-entry"><h3>{m.name}</h3><p class="fine">Audacity {m.version}<br />{m.fileLabel}</p><img class="netdisk-qr" src={m.qr} alt={`${m.name} Audacity ${m.version} 下载二维码`} width="200" height="200" loading="lazy" />{m.code ? <p class="extraction-code">提取码：<strong>{m.code}</strong> <button class="copy" data-copy={m.code}>复制</button></p> : <p class="extraction-code">无需提取码</p>}<a class="button" href={m.url} rel={m.affiliate ? 'sponsored noopener noreferrer' : 'noopener noreferrer'} target="_blank">打开{m.name} ↗</a><button class="copy copy-share" data-copy={m.url}>复制分享链接</button></section>)}</div>{mirrors.some(x => x.affiliate) && <p class="fine">推广说明：通过这些网盘链接产生符合平台规则的行为，本站可能获得佣金。Audacity 本身免费，使用软件不要求购买网盘会员。</p>}</section>}
