---
import QRCode from 'qrcode';
import downloads from '../data/downloads.json';
import { validateDownloads } from '../../scripts/config.mjs';
validateDownloads(downloads);
const mirrors = await Promise.all(downloads.mirrors.filter(x => x.enabled).map(async m => ({ ...m, qr: await QRCode.toDataURL(m.url, { width: 320, margin: 3, errorCorrectionLevel: 'M', color: { dark: '#17213b', light: '#ffffff' } }) })));
---
{mirrors.length > 0 && <section class="mirror-panel" aria-labelledby="mirror-heading"><h2 id="mirror-heading">网盘下载</h2><p class="fine">选择你使用的网盘。二维码与下方按钮指向同一个分享页面；是否需要登录、转存或客户端，以网盘提示为准。</p><div class="mirrors">{mirrors.map(m => <button class="button" data-dialog={`mirror-${m.id}`}>{m.name}下载 · 扫码 / 链接</button>)}</div>{mirrors.some(x => x.affiliate) && <p class="fine">推广说明：通过这些网盘链接产生符合平台规则的行为，本站可能获得佣金。Audacity 本身免费，使用软件不要求购买网盘会员。</p>}</section>}
{mirrors.map(m => <dialog id={`mirror-${m.id}`} aria-labelledby={`title-${m.id}`}><button class="close-dialog" aria-label="关闭下载窗口" data-close>×</button><h2 id={`title-${m.id}`}>{m.name}下载</h2><p>{m.fileLabel} · Audacity {m.version}</p><img class="qr" src={m.qr} alt={`${m.name}分享链接二维码`} width="220" height="220" />{m.code && <p>提取码：<strong>{m.code}</strong> <button class="copy" data-copy={m.code}>复制提取码</button></p>}<a class="button" href={m.url} rel={m.affiliate ? 'sponsored noopener noreferrer' : 'noopener noreferrer'} target="_blank">在浏览器打开网盘 ↗</a><button class="button secondary" data-copy={m.url}>复制分享链接</button><p>在手机上可直接打开链接，无需再用另一台设备扫码。{m.affiliate && '此入口为推广链接，符合条件的行为可能为本站产生佣金。'}</p></dialog>)}
<script>
  let trigger: HTMLElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('[data-dialog]').forEach(button => {
    button.addEventListener('click', () => { const dialog = document.getElementById(button.dataset.dialog || '') as HTMLDialogElement | null; if (dialog) { trigger = button; dialog.showModal(); } });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach(dialog => {
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { if (event.target === dialog) { const b = dialog.getBoundingClientRect(); if (event.clientX < b.left || event.clientX > b.right || event.clientY < b.top || event.clientY > b.bottom) dialog.close(); } });
    dialog.addEventListener('close', () => trigger?.focus());
  });
</script>
