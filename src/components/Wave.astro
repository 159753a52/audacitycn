---
const { orange = false } = Astro.props;
const bars = Array.from({ length: 100 }, (_, i) => {
  const envelope = .15 + Math.abs(Math.sin(i * .18)) * .85;
  return 5 + (Math.abs(Math.sin(i * 1.73) * Math.cos(i * .31)) * 45 + 5) * envelope;
});
---
<svg viewBox="0 0 420 70" aria-hidden="true" preserveAspectRatio="none"><line x1="0" y1="35" x2="420" y2="35" stroke={orange ? '#a68963' : '#718ed9'} stroke-width=".5" />{bars.map((h, i) => <rect x={i * 4.2} y={35 - h / 2} width="2.4" height={h} rx="1" fill={orange ? '#edb574' : '#96b5ff'} />)}</svg>
