---
import Base from '../../layouts/Base.astro';
import { guides } from '../../data/guides';
import type { Guide } from '../../data/guides';
export function getStaticPaths() { return guides.map(guide => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide } = Astro.props as { guide: Guide };
const related = guide.related.map(slug => guides.find(g=>g.slug===slug)).filter((g): g is Guide => Boolean(g));
---
<Base title={`${guide.title}｜Audacity 中文指南`} description={guide.intro} article updated={guide.updated} breadcrumbs={[{name:'使用教程',path:'/guides/'},{name:guide.short,path:`/guides/${guide.slug}/`}]}>
  <div class="container"><header class="page-heading"><nav class="breadcrumb" aria-label="当前位置"><a href="/">首页</a> / <a href="/guides/">使用教程</a> / {guide.short}</nav><span class="eyebrow">{guide.category}</span><h1>{guide.title}</h1><p class="lead">{guide.intro}</p><div class="article-meta"><span>适用：{guide.applies}</span><span>内容核对：<time datetime={guide.updated}>{guide.updated}</time></span><a href="/about/">维护：Audacity 中文指南</a></div></header>
    <div class="article-grid"><article class="article"><div class="answer-box"><strong>先看设置</strong><p>{guide.answer}</p></div><details class="mobile-toc"><summary>本页目录</summary><nav aria-label="手机页面目录">{guide.sections.map((s,i)=><a href={`#step-${i+1}`}>{i+1}. {s.title}</a>)}<a href="#references">资料来源</a></nav></details>{guide.sections.map((s,i)=><section id={`step-${i+1}`}><h2>{i+1}. {s.title}</h2>{s.paragraphs?.map(p=><p>{p}</p>)}{s.steps&&<ol>{s.steps.map(step=><li>{step}</li>)}</ol>}{s.table&&<div class="table-scroll" role="region" aria-label={s.title} tabindex="0"><table class="data-table"><thead><tr>{s.table.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{s.table.rows.map(row=><tr>{row.map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div>}{s.code&&<pre><code>{s.code}</code></pre>}{s.note&&<p class="note">{s.note}</p>}</section>)}{guide.tip&&<p class="note">{guide.tip}</p>}<section class="sources" id="references"><h2>资料来源</h2><p class="fine">本页按以下资料整理。界面有差异时，先核对软件版本和菜单英文名。</p><ul>{guide.sources.map(([label,url])=><li><a href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a></li>)}</ul></section><section class="related-list"><h2>相关问题</h2>{related.map(g=><a href={`/guides/${g.slug}/`}>{g.title} →</a>)}</section><div class="actions"><a class="button secondary" href="/download/">下载与版本选择</a><a class="text-link" href="/guides/">所有教程 →</a></div></article>
    <nav class="toc" aria-label="本页目录"><strong>本页内容</strong>{guide.sections.map((s,i)=><a href={`#step-${i+1}`}>{i+1}. {s.title}</a>)}<a href="#references">资料来源</a></nav></div>
  </div>
</Base>
