---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { guides } from '../../data/guides';
import { guideIcons, categoryTones } from '../../data/ui';
const categories = [...new Set(guides.map(g => g.category))];
---
<Base title="Audacity 中文使用教程：安装、录音、剪辑与问题排查" description="按问题查找 Audacity 中文教程。包含 x64 安装、麦克风录音、Windows WASAPI 内录、降噪参数、MP3 导出、M4A 导入失败与录音无声排查。" breadcrumbs={[{name:'使用教程',path:'/guides/'}]}>
  <PageHeader crumbs={[{ name: '使用教程' }]} title="Audacity 中文使用教程" lead="先看适用版本，再按设置表与操作步骤处理。3.x 和 4.x 的菜单、工程格式与快捷键有差异，文章中会单独说明。">
    <div class="search-box">
      <Icon name="search" size={20} />
      <label for="guide-search" class="sr-only">搜索当前 {guides.length} 篇教程</label>
      <input id="guide-search" type="search" placeholder="搜索：录音、电脑声音、MP3、M4A…" autocomplete="off" aria-describedby="search-status" />
    </div>
    <div class="filter-chips" role="group" aria-label="按分类筛选">
      <button type="button" data-filter="" aria-pressed="true">全部</button>
      {categories.map(c => <button type="button" data-filter={c} aria-pressed="false">{c}</button>)}
    </div>
  </PageHeader>
  <section class="section-sm">
    <div class="container">
      <p class="fine list-status" id="search-status" role="status" aria-live="polite">共 {guides.length} 篇</p>
      <div class="guide-grid guide-grid-3" id="guide-list">
        {guides.map(g => <a class:list={['guide-card', `tone-${categoryTones[g.category] ?? 'blue'}`]} data-category={g.category} data-search={`${g.title} ${g.short} ${g.intro} ${g.category} ${g.applies} ${g.answer}`} href={`/guides/${g.slug}/`}>
          <span class="guide-card-top"><span class="icon-tile"><Icon name={guideIcons[g.slug] ?? 'book'} size={22} /></span><span class="guide-cat">{g.category}</span></span>
          <h2>{g.title}</h2>
          <p>{g.intro}</p>
          <span class="guide-applies">{g.applies} · 核对 {g.updated}</span>
        </a>)}
      </div>
      <p class="empty-search" id="search-empty" hidden>没有找到。换一个关键词，或查看<a class="text-link" href="/faq/">常见问题</a>。</p>
      <div class="callout list-callout">
        <div><h2>不确定问题在哪一步？</h2><p>从波形、设备、文件格式和软件版本开始判断。</p></div>
        <a class="btn btn-secondary" href="/guides/no-sound/"><Icon name="mute" size={18} />录音无声排查</a>
      </div>
    </div>
  </section>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('#guide-search');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-search]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const empty = document.getElementById('search-empty');
  const status = document.getElementById('search-status');
  let category = '';
  const apply = () => {
    const query = (input?.value || '').trim().toLocaleLowerCase();
    let count = 0;
    for (const row of rows) {
      row.hidden = !((!category || row.dataset.category === category) && (row.dataset.search || '').toLocaleLowerCase().includes(query));
      if (!row.hidden) count++;
    }
    if (empty) empty.hidden = count > 0;
    if (status) status.textContent = query || category ? `找到 ${count} 篇` : `共 ${count} 篇`;
  };
  input?.addEventListener('input', apply);
  chips.forEach(chip => chip.addEventListener('click', () => {
    category = chip.dataset.filter || '';
    chips.forEach(other => other.setAttribute('aria-pressed', String(other === chip)));
    apply();
  }));
</script>
