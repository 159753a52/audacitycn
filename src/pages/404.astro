---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="页面未找到｜Audacity 中文指南" description="这个页面可能已移动。返回首页或教程目录，继续查找 Audacity 中文下载与操作说明。" noindex>
  <section class="not-found">
    <div class="container">
      <p class="not-found-code">404 / NOT FOUND</p>
      <h1>这一页没有找到。</h1>
      <p class="page-lead">可能是地址有误，或页面已经移动。</p>
      <div class="not-found-actions"><a class="btn btn-primary" href="/">回到首页</a><a class="btn btn-secondary" href="/guides/"><Icon name="book" size={18} />查看教程目录</a><a class="btn btn-secondary" href="/download/"><Icon name="download" size={18} />下载中心</a></div>
    </div>
  </section>
</Base>
