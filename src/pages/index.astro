---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Waveform from '../components/Waveform.astro';
import { guides } from '../data/guides';
import { platforms } from '../data/platforms';
import { guideIcons, categoryTones, platformIcons, platformShort, archChoices } from '../data/ui';
import downloads from '../data/downloads.json';
const questions = [
  ['录音是一条直线', '/guides/no-sound/', '先检查输入设备和系统权限'],
  ['要录电脑里的声音', '/guides/record-desktop/', 'Windows WASAPI 与 loopback'],
  ['工程文件发给别人打不开', '/guides/export-audio/', '先导出 MP3 或 WAV'],
  ['M4A 文件导不进来', '/guides/ffmpeg/', '检查文件与 FFmpeg 架构'],
];
const coverage = (group: typeof downloads | typeof downloads.legacy) => platforms.map(p => ({
  id: p.id, name: p.name,
  archs: archChoices[p.id].filter(a => group.files.some(f => f.platform === p.id && f.architecture === a.id)).map(a => a.short),
}));
const platformOrder = ['windows', 'macos', 'linux'];
const formats = (group: typeof downloads | typeof downloads.legacy) => [...new Set(group.files.filter(f => f.platform !== 'shared').sort((a, b) => platformOrder.indexOf(a.platform) - platformOrder.indexOf(b.platform)).map(f => f.format))].join(' · ');
const versions = [
  { group: downloads, label: '当前版', project: '.aup4', note: '初次使用从这里开始。官方当前测试 Windows 10 / 11、macOS 14 / 15、Ubuntu 22.04。' },
  { group: downloads.legacy, label: '3.x 旧版', project: '.aup3', note: '需要 32 位 Windows 程序，或继续使用 3.x 工程与插件时选择。' },
];
const homeGuides = guides.slice(0, 8);
---
<Base title="Audacity 中文版下载与使用教程：录音、剪辑、降噪、导出 MP3" description="Audacity 独立中文指南：Windows、Mac、Linux 的 4.0.1 / 3.7.9 下载与版本选择，以及设置中文界面、麦克风录音、WASAPI 电脑内录、降噪和 MP3 导出的分步教程。">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker"><span class="pulse" aria-hidden="true"></span>独立中文资料站 · 整理 {downloads.version} 与 {downloads.legacy.version}</p>
        <h1>Audacity 中文下载<br />与使用教程</h1>
        <p class="hero-lead">免费开源的录音与音频剪辑软件。按系统和电脑类型选好版本，获取官方原始安装包；设置中文、录音、电脑内录、降噪和导出都有分步说明，并标注 3.x / 4.x 的区别。</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href="/download/"><Icon name="download" />下载 Audacity {downloads.version}</a>
          <a class="btn btn-glass btn-lg" href="/guides/"><Icon name="book" />看中文教程</a>
        </div>
        <ul class="hero-os" aria-label="按系统下载">
          {platforms.map(p => <li><a href={`/download/${p.id}/`}><Icon name={platformIcons[p.id]} size={22} /><span><strong>{p.name}</strong><small>{platformShort[p.id]}</small></span></a></li>)}
        </ul>
      </div>
      <Waveform current={downloads.version} legacy={downloads.legacy.version} />
    </div>
  </section>

  <section class="section" aria-labelledby="guides-heading">
    <div class="container">
      <div class="section-head">
        <div><h2 id="guides-heading">按问题找教程</h2><p>每篇先给设置结论，再列步骤、对照表和资料来源。</p></div>
        <a class="link-more" href="/guides/">全部 {guides.length} 篇教程<Icon name="arrow" size={18} /></a>
      </div>
      <div class="guide-grid">
        {homeGuides.map(g => <a class:list={['guide-card', `tone-${categoryTones[g.category] ?? 'blue'}`]} href={`/guides/${g.slug}/`}>
          <span class="guide-card-top"><span class="icon-tile"><Icon name={guideIcons[g.slug] ?? 'book'} size={22} /></span><span class="guide-cat">{g.category}</span></span>
          <h3>{g.short}</h3>
          <p>{g.intro}</p>
          <span class="guide-applies">{g.applies}</span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="section section-white" aria-labelledby="quick-heading">
    <div class="container quick-grid">
      <div>
        <h2 id="quick-heading" class="quick-title">遇到这些情况</h2>
        <p class="quick-sub">从现象直接跳到排查步骤。</p>
        <ul class="quick-list">
          {questions.map(([q, url, note]) => <li><a href={url}><span><strong>{q}</strong><small>{note}</small></span><Icon name="arrow" size={18} /></a></li>)}
        </ul>
      </div>
      <div class="tip-stack">
        <div class="tip-card"><span class="icon-tile"><Icon name="play" size={22} /></span><div><h3>第一次用 Audacity</h3><p>按官方 4.x 入门顺序：建轨道、录音、看波形、剪辑、加效果、保存和导出，一页走通。</p><a class="link-more" href="/guides/getting-started/">新手入门<Icon name="arrow" size={16} /></a></div></div>
        <div class="tip-card"><span class="icon-tile"><Icon name="language" size={22} /></span><div><h3>界面不是中文</h3><p>中文界面是程序自带的，不需要汉化包。4.x 在偏好设置的 General 页、3.x 在 Interface 页切换语言。</p><a class="link-more" href="/guides/chinese-language/">设置中文界面<Icon name="arrow" size={16} /></a></div></div>
        <div class="tip-card"><span class="icon-tile"><Icon name="file" size={22} /></span><div><h3>工程与音频</h3><p>4.x 保存 .aup4 工程，3.x 保存 .aup3。给别人播放时，导出 MP3、WAV 等音频文件。</p><a class="link-more" href="/guides/export-audio/">格式与文件大小对照<Icon name="arrow" size={16} /></a></div></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="versions-heading">
    <div class="container">
      <div class="section-head">
        <div><h2 id="versions-heading">两个版本，按需选择</h2><p>文件取自 Audacity 官方发布记录，保留原始文件名，不重新打包。</p></div>
        <a class="link-more" href="/download/">进入下载中心<Icon name="arrow" size={18} /></a>
      </div>
      <div class="version-grid">
        {versions.map(({ group, label, project, note }, index) => <article class:list={['version-card', { 'is-current': index === 0 }]}>
          <header><span class:list={['chip', { 'chip-primary': index === 0 }]}>{label}</span><h3>Audacity {group.version}</h3><p>{note}</p></header>
          <dl class="version-specs">
            {coverage(group).map(row => <div><dt><Icon name={platformIcons[row.id]} size={18} />{row.name}</dt><dd>{row.archs.join(' · ')}</dd></div>)}
            <div><dt><Icon name="file" size={18} />工程格式</dt><dd>{project}</dd></div>
            <div><dt><Icon name="download" size={18} />安装包</dt><dd>{formats(group)}</dd></div>
          </dl>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section-sm trust" aria-labelledby="trust-heading">
    <div class="container">
      <h2 id="trust-heading" class="sr-only">资料从哪里来</h2>
      <div class="trust-grid">
        <div><Icon name="shield" size={22} /><p><strong>原始文件</strong>安装包来自 Audacity 官方发布记录，保留原始文件名，未重新打包。</p></div>
        <div><Icon name="calendar" size={22} /><p><strong>标注版本</strong>教程注明适用版本与核对日期，3.x / 4.x 的菜单差异单独说明。</p></div>
        <div><Icon name="book" size={22} /><p><strong>列出来源</strong>操作说明参考对应版本的官方手册。本站与软件项目无隶属关系。</p></div>
      </div>
      <p class="trust-more"><a class="link-more" href="/about/">维护与来源说明<Icon name="arrow" size={16} /></a></p>
    </div>
  </section>
</Base>
